# Fahad Gsn — Cloudflare Workers Environment Variables
# Copy this to .env.local for local dev (without D1/R2 — use wrangler dev for that)

# ─── Cloudflare ───────────────────────────────────────────────
# Set these as Secrets in Cloudflare Dashboard (not wrangler.jsonc)
SESSION_SECRET=change-me-to-a-random-64-char-string

# R2 Public URL — set after enabling public access on your R2 bucket
# Format: https://pub-XXXXXXXXXXXXXXXXXXXXXXXXXXXXX.r2.dev
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# Optional: custom domain for R2 (if configured)
# R2_PUBLIC_HOSTNAME=media.fahadgsn.com

# ─── Public (can go in wrangler.jsonc vars section) ───────────
NEXT_PUBLIC_SITE_URL=https://fahad-gsn.workers.dev
NEXT_PUBLIC_WHATSAPP_NUMBER=96598908022
