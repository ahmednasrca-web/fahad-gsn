# Fahad Gsn — Environment Variables
# Copy to .env.local and fill in your values

# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Session ────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-session-secret-at-least-32-chars-long

# ── Site ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://fahadgsn.com
NEXT_PUBLIC_WHATSAPP_NUMBER=96598908022

# ── Admin ──────────────────────────────────────────────────
# The email used to log into the admin dashboard
# Set this user up in Supabase Auth dashboard
ADMIN_EMAIL=admin@fahadgsn.com
